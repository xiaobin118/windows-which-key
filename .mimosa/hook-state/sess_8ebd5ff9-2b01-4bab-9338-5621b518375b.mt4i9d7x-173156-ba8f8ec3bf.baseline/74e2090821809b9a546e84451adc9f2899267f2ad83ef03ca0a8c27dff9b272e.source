use crate::theme::ThemeConfig;
use crate::types::{DisplayEntry, UiCommand};
use crate::webview_bridge::WebView2Bridge;
use crate::webview_bridge::FRONTEND_HTML;
use crate::window_manager::{dpi_factor_for, WindowManager};
use anyhow::{Context, Result};
use std::collections::HashSet;

pub struct OverlayController {
    window_manager: WindowManager,
    webview_bridge: Option<WebView2Bridge>,
    theme: ThemeConfig,
    /// 覆盖层窗口所在显示器的 DPI 缩放系数（PMv2 下必须用
    /// GetDpiForWindow，GetDpiForSystem 恒返回 96）。
    dpi_factor: f64,
}

/// CSS 像素尺寸下的屏幕信息（物理尺寸 / DPI 缩放）。
struct CssScreen {
    width: i32,
    height: i32,
}

fn css_screen(dpi_factor: f64) -> CssScreen {
    use windows::Win32::UI::WindowsAndMessaging::{GetSystemMetrics, SM_CXSCREEN, SM_CYSCREEN};
    let (w, h) = unsafe { (GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN)) };
    CssScreen {
        width: (w as f64 / dpi_factor) as i32,
        height: (h as f64 / dpi_factor) as i32,
    }
}

/// 估算浮层需要的 CSS 像素高度，配合前端“贴底 + 多列平铺 + 不滚动”
/// 的 neovim which-key 布局。数值对应 frontend.html 的布局参数。
fn estimate_css_height(entries: &[DisplayEntry], grouped: bool, screen: &CssScreen) -> i32 {
    // 列数 = 可用宽度 / 最小列宽（前端 grid minmax(300px, 1fr) + 间距）
    let columns = (((screen.width - 48) / 316).max(1) as usize).max(1);
    let rows = entries.len().div_ceil(columns) as i32;

    let headers = if grouped {
        entries
            .iter()
            .map(|entry| entry.category.as_str())
            .collect::<HashSet<_>>()
            .len() as i32
    } else {
        0
    };

    let topbar = 62;
    let breadcrumb = if grouped { 0 } else { 46 };
    let app_name = if grouped { 34 } else { 0 };
    let footer = 36;
    let padding = 40;

    let height = topbar + breadcrumb + app_name + headers * 30 + rows * 46 + footer + padding;
    height.clamp(140, (screen.height - 16).max(140))
}

impl OverlayController {
    pub fn new() -> Result<Self> {
        let mut window_manager = WindowManager::new();
        let hwnd = window_manager
            .create_window()
            .context("Failed to create overlay window")?;

        let dpi_factor = dpi_factor_for(hwnd);
        // 初始按屏幕底部条带创建；每次显示时按内容重新定尺寸
        let screen_w = unsafe {
            windows::Win32::UI::WindowsAndMessaging::GetSystemMetrics(
                windows::Win32::UI::WindowsAndMessaging::SM_CXSCREEN,
            )
        };
        let initial_height = (200.0 * dpi_factor).round() as i32;
        let webview_bridge =
            WebView2Bridge::new(hwnd, screen_w, initial_height).context("初始化 WebView2 失败")?;
        webview_bridge
            .load_html(FRONTEND_HTML)
            .context("加载覆盖层 HTML 失败")?;

        Ok(OverlayController {
            window_manager,
            webview_bridge: Some(webview_bridge),
            theme: ThemeConfig::default_theme(),
            dpi_factor,
        })
    }

    /// neovim which-key 风格：全宽、贴屏幕底边，高度随内容自适应，
    /// 所有条目平铺展示，不出现滚动条。WebView bounds 同步缩放。
    fn show_bottom(&mut self, entries: &[DisplayEntry], grouped: bool) -> Result<()> {
        use windows::Win32::UI::WindowsAndMessaging::{GetSystemMetrics, SM_CXSCREEN, SM_CYSCREEN};

        let screen_w = unsafe { GetSystemMetrics(SM_CXSCREEN) };
        let screen_h = unsafe { GetSystemMetrics(SM_CYSCREEN) };

        let screen = css_screen(self.dpi_factor);
        let css_height = estimate_css_height(entries, grouped, &screen);
        let height = (css_height as f64 * self.dpi_factor).round() as i32;
        let height = height.min(screen_h - (8.0 * self.dpi_factor) as i32);
        let height = height.max((140.0 * self.dpi_factor) as i32);
        let y = (screen_h - height).max(0);

        self.window_manager.show(0, y, screen_w, height)?;
        if let Some(ref bridge) = self.webview_bridge {
            bridge.resize(screen_w, height)?;
        }
        Ok(())
    }

    pub fn execute(&mut self, cmd: UiCommand) -> Result<()> {
        match cmd {
            UiCommand::Show {
                position,
                entries,
                breadcrumb,
            } => {
                log::debug!("Show overlay at {:?}, {} entries", position, entries.len());
                self.show_bottom(&entries, false)?;

                if let Some(ref bridge) = self.webview_bridge {
                    // 页面可能在启动早期未加载完成，每次显示都重发主题，
                    // 保证 CSS 变量最终生效
                    bridge.send_command(&UiCommand::ApplyTheme {
                        theme: self.theme.clone(),
                    })?;
                    bridge.send_command(&UiCommand::Show {
                        position,
                        entries,
                        breadcrumb,
                    })?;
                }
            }
            UiCommand::UpdateEntries {
                entries,
                breadcrumb,
            } => {
                log::debug!("Update entries: {} entries", entries.len());
                // 条目数变化可能改变面板高度，重新贴底排版
                self.show_bottom(&entries, false)?;
                if let Some(ref bridge) = self.webview_bridge {
                    bridge.send_command(&UiCommand::UpdateEntries {
                        entries,
                        breadcrumb,
                    })?;
                }
            }
            UiCommand::ApplyTheme { theme } => {
                self.theme = theme.clone();
                if let Some(ref bridge) = self.webview_bridge {
                    bridge.send_command(&UiCommand::ApplyTheme { theme })?;
                }
            }
            UiCommand::ShowAll { app_name, entries } => {
                self.show_bottom(&entries, true)?;
                if let Some(ref bridge) = self.webview_bridge {
                    bridge.send_command(&UiCommand::ApplyTheme {
                        theme: self.theme.clone(),
                    })?;
                    bridge.send_command(&UiCommand::ShowAll { app_name, entries })?;
                }
            }
            UiCommand::Hide => {
                log::debug!("Hide overlay");
                self.window_manager.hide()?;
                if let Some(ref bridge) = self.webview_bridge {
                    bridge.send_command(&UiCommand::Hide)?;
                }
            }
        }
        Ok(())
    }
}
