{
  "permissions": {
    "allow": [
      "Bash(cargo --version)",
      "Bash(rustc --version)",
      "Bash(npx *)",
      "Bash(git init *)",
      "Bash(cargo init *)",
      "Bash(cargo check *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(cargo test *)",
      "Bash(Select-Object -Last 30)",
      "Bash(cargo build *)",
      "Bash(Select-Object -Last 20)",
      "Bash(cargo doc *)",
      "Bash(cargo tree *)",
      "PowerShell(Stop-Process *)",
      "Bash(RUST_LOG=info timeout 5 ./target/debug/which-key-windows.exe)",
      "Bash(echo \"exit: $?\")",
      "Bash(cargo run *)",
      "Bash(RUST_LOG=info timeout 8 ./target/debug/which-key-windows.exe)"
    ]
  }
}
